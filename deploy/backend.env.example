# Copy to .env.backend in the server installation. This is sourced by Bash.
# Quote values containing spaces, $, #, or shell metacharacters. chmod 600 the file.
# See docs/CONFIG.md for per-process settings and flag precedence.
MARIONETTE_OIDC_ISSUER=https://sso.example.com/realms/team
MARIONETTE_OIDC_CLIENT_ID=marionette
MARIONETTE_OIDC_CLIENT_SECRET=replace-with-your-existing-client-secret
# Defaults to MARIONETTE_PUBLIC_URL + /auth/callback.
MARIONETTE_OIDC_REDIRECT_URL=
MARIONETTE_PUBLIC_URL=https://api.example.com
MARIONETTE_FRONTEND_ORIGINS=https://devices.example.com
MARIONETTE_ADMIN_EMAILS=admin@example.com
MARIONETTE_ADMIN_SUBJECTS=
MARIONETTE_LISTEN=127.0.0.1:8080
# Keep the original private state directory when migrating an existing deployment.
# MARIONETTE_DATA_DIR=/var/lib/marionette
# MARIONETTE_STATE_DIR=/absolute/private/existing/.marionette
# The source launcher passes state-file flags. Set these path overrides when invoking the binary directly.
# MARIONETTE_TOKEN_FILE=/var/lib/marionette/tokens.json
# MARIONETTE_USER_FILE=/var/lib/marionette/users.json
# MARIONETTE_OAUTH_FILE=/var/lib/marionette/oauth.json
# MARIONETTE_AGENT_FILE=/var/lib/marionette/agents.json
# MARIONETTE_JOB_FILE=/var/lib/marionette/jobs.json
# MARIONETTE_AGENT_TOKENS='{"office-mac":"replace-with-a-random-token-of-at-least-32-bytes"}'
# MARIONETTE_AGENT_PACKAGES=build
# MARIONETTE_INSTALL_SCRIPT=scripts/setup-ubuntu-agent.sh
# MARIONETTE_SESSION_TTL=8h
# MARIONETTE_OAUTH_ACCESS_TTL=1h
# MARIONETTE_OAUTH_REFRESH_TTL=720h
# MARIONETTE_OAUTH_CODE_TTL=5m
# MARIONETTE_VIDEO_MAX_GLOBAL=128
# MARIONETTE_VIDEO_MAX_PER_ACCOUNT=4
# MARIONETTE_LEASE_DEFAULT_TTL=5m
# MARIONETTE_LEASE_MAX_TTL=1h
# MARIONETTE_LOG_LEVEL=info
# MARIONETTE_LOG_FORMAT=text
# Optional jobs: retain the same broker/topic/runner secret on backend and runner.
MARIONETTE_KAFKA_BROKERS=
MARIONETTE_KAFKA_TOPIC=marionette.jobs
MARIONETTE_KAFKA_TLS=false
MARIONETTE_KAFKA_USERNAME=
MARIONETTE_KAFKA_PASSWORD=
MARIONETTE_RUNNER_TOKEN=
# MARIONETTE_JOB_RETENTION=168h
# MARIONETTE_JOB_ARTIFACT_MAX_BYTES_PER_ACCOUNT=268435456
