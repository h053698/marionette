[Unit]
Description=Marionette Android device agent
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/marionette-agent
ExecStart=/bin/bash "%h/.local/share/marionette-agent/start-agent.sh"
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
