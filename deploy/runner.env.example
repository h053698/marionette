# Copy to .env.runner in the server installation; chmod 600 the file.
MARIONETTE_BACKEND_URL=https://api.example.com
MARIONETTE_KAFKA_BROKERS=127.0.0.1:9092
MARIONETTE_KAFKA_TOPIC=marionette.jobs
MARIONETTE_KAFKA_TLS=false
MARIONETTE_KAFKA_USERNAME=
MARIONETTE_KAFKA_PASSWORD=
MARIONETTE_RUNNER_TOKEN=replace-with-the-existing-backend-runner-secret
# MARIONETTE_RUNNER_GROUP=marionette-runners
# MARIONETTE_LOG_LEVEL=info
# MARIONETTE_LOG_FORMAT=text
