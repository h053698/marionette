# 작업 큐를 사용하는 경우에만 deploy/docker/jobs.env로 복사합니다.
# Compose env_file은 raw 형식입니다. 따옴표 없이 KEY=value로 씁니다.
# 이 파일은 백엔드와 러너가 함께 읽습니다.
MARIONETTE_KAFKA_BROKERS=kafka:9092
MARIONETTE_KAFKA_TOPIC=marionette.jobs
MARIONETTE_KAFKA_TLS=false
MARIONETTE_KAFKA_USERNAME=
MARIONETTE_KAFKA_PASSWORD=
# 선택 사항. 같은 토픽을 처리하는 러너에 동일한 그룹을 사용합니다.
# MARIONETTE_RUNNER_GROUP=marionette-runners
# openssl rand -hex 32로 생성한 별도 비밀값으로 바꿉니다.
MARIONETTE_RUNNER_TOKEN=replace-with-a-random-runner-secret
