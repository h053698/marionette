# deploy/docker/backend.env로 복사하고 chmod 600을 적용합니다.
# Compose env_file은 raw 형식입니다. 따옴표 없이 KEY=value로 씁니다.
# 전체 환경 변수 목록은 docs/CONFIG.md를 참고하세요.

# 회사 OIDC confidential web client와 등록된 HTTPS 콜백입니다.
MARIONETTE_OIDC_ISSUER=https://sso.example.com/realms/team
MARIONETTE_OIDC_CLIENT_ID=marionette
MARIONETTE_OIDC_CLIENT_SECRET=replace-with-your-client-secret
MARIONETTE_OIDC_REDIRECT_URL=https://devices.example.com/auth/callback
MARIONETTE_PUBLIC_URL=https://devices.example.com

# 단일 오리진에서는 비웁니다. 분리 배포에서는 UI 오리진을 지정합니다.
MARIONETTE_FRONTEND_ORIGINS=
# 검증된 이메일 또는 정확한 OIDC sub를 쉼표로 구분합니다.
MARIONETTE_ADMIN_EMAILS=admin@example.com
MARIONETTE_ADMIN_SUBJECTS=
# 선택 사항. 대시보드에서 등록하는 경우 비워 둡니다.
# MARIONETTE_AGENT_TOKENS={"lab-pc":"replace-with-at-least-32-random-bytes"}

# Kafka와 러너 설정은 선택 사항인 jobs.env.example을 참고하세요.
