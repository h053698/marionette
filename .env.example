# See docs/CONFIG.md for the settings for each process. This file uses shell syntax.
# Register a confidential OIDC web client with this exact callback URL.
# Examples: Keycloak, Authentik, Google Workspace, Microsoft Entra ID.
MARIONETTE_OIDC_ISSUER=https://sso.example.com/realms/team
MARIONETTE_OIDC_CLIENT_ID=marionette
MARIONETTE_OIDC_CLIENT_SECRET=replace-with-your-client-secret
MARIONETTE_OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/callback

# Only verified emails or exact OIDC subjects in these lists become admins.
# Other users who successfully authenticate with this issuer have the user role.
MARIONETTE_ADMIN_EMAILS=admin@example.com
MARIONETTE_ADMIN_SUBJECTS=

# Frontend origin. The backend and frontend are separate processes.
# Comma-separated scheme://host[:port]. The first entry is where users return after sign-in.
# Cross-site cookies need HTTPS on the backend (SameSite=None; Secure).
# For local development use 127.0.0.1 for both services (different ports are OK).
MARIONETTE_FRONTEND_ORIGINS=http://127.0.0.1:3000

# Frontend process only. For static hosting, set this address in web/config.js.
MARIONETTE_API_URL=http://127.0.0.1:8080
# Set MARIONETTE_LISTEN separately for backend and web if needed.
# MARIONETTE_WEB_DIR=web

# Backend process only: optional pre-registered agent IDs and individual secrets.
# Admins can also register PCs in the dashboard; hashes persist in --agent-file.
# Generate a secret for each PC with: openssl rand -hex 32
MARIONETTE_AGENT_TOKENS='{"office-mac":"replace-with-a-random-token-of-at-least-32-bytes"}'

# Agent process only. Each PC uses its own registered identity and secret.
MARIONETTE_BACKEND_URL=http://127.0.0.1:8080
MARIONETTE_AGENT_ID=office-mac
MARIONETTE_AGENT_TOKEN=replace-with-the-same-office-mac-token
MARIONETTE_DEVICE_TAGS=lab,android
# MARIONETTE_DEVICE_ALLOW=physical:*,managed-only
# STUN/TURN for direct ADB (WebRTC). Empty uses public STUN; none disables external servers.
MARIONETTE_ICE_SERVERS=
# MARIONETTE_ICE_USERNAME=
# MARIONETTE_ICE_PASSWORD=
# MARIONETTE_ADB=adb
# MARIONETTE_DEVICE_JAR=build/marionette-device.jar
# MARIONETTE_PLATFORM=android
# MARIONETTE_ANDROID_SDK=/opt/android
# MARIONETTE_STATE_DIR=/absolute/private/agent-state
# MARIONETTE_MAX_EMULATORS=2
# MARIONETTE_MAX_UPLOAD_BYTES=1073741824
# MARIONETTE_MAX_DOWNLOAD_BYTES=536870912
# MARIONETTE_MAX_LEASE_TRANSFERS=2
# MARIONETTE_MAX_AGENT_TRANSFERS=8
# MARIONETTE_MAX_STAGING_BYTES=2147483648
# MARIONETTE_DISCOVERY_INTERVAL=2s
# ANDROID_SDK_ROOT=/opt/android
# ANDROID_HOME=/opt/android
# JAVA_HOME=/opt/jdk
# ADB_SERVER_SOCKET=localfilesystem:/run/adb.sock
# ANDROID_ADB_SERVER_PORT=5037

# Agent policy is managed from the dashboard and persists in --state-dir.
# For managed emulators, install SDK Emulator + Command-line Tools + system image,
# set JAVA_HOME, and pass --android-sdk /absolute/sdk --max-emulators 2.

# Optional backend public origin. Its /auth/callback is used if the redirect is omitted.
MARIONETTE_PUBLIC_URL=
# Backend state paths. A direct binary invocation uses these when no flags override them.
# MARIONETTE_DATA_DIR=.marionette
# MARIONETTE_TOKEN_FILE=.marionette/tokens.json
# MARIONETTE_USER_FILE=.marionette/users.json
# MARIONETTE_OAUTH_FILE=.marionette/oauth.json
# MARIONETTE_AGENT_FILE=.marionette/agents.json
# MARIONETTE_JOB_FILE=.marionette/jobs.json
# MARIONETTE_AGENT_PACKAGES=build
# MARIONETTE_INSTALL_SCRIPT=scripts/setup-ubuntu-agent.sh
# MARIONETTE_SESSION_TTL=8h
# MARIONETTE_OAUTH_ACCESS_TTL=1h
# MARIONETTE_OAUTH_REFRESH_TTL=720h
# MARIONETTE_OAUTH_CODE_TTL=5m
# MARIONETTE_VIDEO_MAX_GLOBAL=128
# MARIONETTE_VIDEO_MAX_PER_ACCOUNT=4

# Use the same lease policy on the backend and agents.
# MARIONETTE_LEASE_DEFAULT_TTL=5m
# MARIONETTE_LEASE_MAX_TTL=1h
# MARIONETTE_LOG_LEVEL=info
# MARIONETTE_LOG_FORMAT=text

# Optional Kafka jobs. Empty brokers disables the job queue on the backend.
# Backend and runners share Kafka settings and a separate random runner secret.
MARIONETTE_KAFKA_BROKERS=
MARIONETTE_KAFKA_TOPIC=marionette.jobs
MARIONETTE_KAFKA_TLS=false
MARIONETTE_KAFKA_USERNAME=
MARIONETTE_KAFKA_PASSWORD=
MARIONETTE_RUNNER_TOKEN=
# MARIONETTE_RUNNER_GROUP=marionette-runners
# MARIONETTE_JOB_RETENTION=168h
# MARIONETTE_JOB_ARTIFACT_MAX_BYTES_PER_ACCOUNT=268435456
