# Copy to .env beside start-agent.sh on the computer connected to the phones.
# This token must match this agent's entry in the backend's MARIONETTE_AGENT_TOKENS.
MARIONETTE_BACKEND_URL=https://api.example.com
MARIONETTE_AGENT_ID=office-mac
MARIONETTE_AGENT_TOKEN=replace-with-a-random-token-of-at-least-32-bytes
